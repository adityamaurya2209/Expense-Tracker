# Copy this file to .env for local development (never commit .env).

# TiDB Cloud Serverless connection string.
# TiDB Cloud console -> your cluster -> Connect -> "Connect With: General" -> copy the URL.
# Format: mysql://USER:PASSWORD@HOST:4000/DATABASE
DATABASE_URL=mysql://xxxxxxxx.root:your-password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/expense_tracker

# Long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Set to "false" only when using a plain local MySQL server without TLS.
# DB_SSL=false

PORT=3000
